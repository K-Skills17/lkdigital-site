# Database — Neon Postgres (all tables; schema in db/schema.sql, apply with `npm run db:migrate`)
# Use the pooled connection string from the Neon console.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Evolution API (WhatsApp)
EVOLUTION_API_URL=https://your-evolution-instance.com
EVOLUTION_API_KEY=your-api-key
EVOLUTION_INSTANCE=your-instance-name

# Google Tag Manager (optional — only renders if set)
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Demo page tenant — swap this to point /demo at a different trained tenant
NEXT_PUBLIC_DEMO_TENANT_ID=your-demo-tenant-uuid-here

# RAIO-X Scorecard Funnel
TELEGRAM_BOT_TOKEN=           # @Lkdigital_bot token
NOTIFY_KOMANDO_CHAT_ID=       # Send /start to @Lkdigital_bot, then check getUpdates
NOTIFY_MARCOS_CHAT_ID=        # Marcos must also send /start to @Lkdigital_bot

# RAIO-X public config
NEXT_PUBLIC_LK_BOOKING_URL=   # LK Digital booking/cal link
NEXT_PUBLIC_MARCOS_BOOKING_URL=  # Biodonte booking link (leave empty to fall back to WA)
NEXT_PUBLIC_MARCOS_WA_NUMBER=    # Marcos WhatsApp intl format e.g. 5511999990000

# ─── Backbone (src/lib/backbone) — shared by every free tool under /ferramentas ───
# AI — Claude and/or OpenAI. Set at least one key; with both, AI_PROVIDER goes first and the
# other is the automatic fallback. Models: src/lib/backbone/models.ts (overrides optional).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# AI_PROVIDER=anthropic                     # or: openai
# AI_MODEL_FAST=claude-haiku-4-5-20251001   # Claude — WhatsApp action plans
# AI_MODEL_SMART=claude-sonnet-4-6          # Claude — blog engine / long-form
# OPENAI_MODEL_FAST=gpt-5.4-mini            # OpenAI — WhatsApp action plans
# OPENAI_MODEL_SMART=gpt-5.5                # OpenAI — blog engine / long-form

# WhatsApp delivery — LK Chatbot first (keeps the conversation in the bot), Evolution as fallback
LK_CHATBOT_URL=https://lk-chatbot-production.up.railway.app
LK_CHATBOT_API_KEY=
LK_CHATBOT_TENANT_ID=
# EVOLUTION_API_URL / EVOLUTION_API_KEY / EVOLUTION_INSTANCE above are reused as the fallback

# Meta Conversions API (server-side Lead events, deduped with the browser pixel)
FB_PIXEL_ID=812107305229720
FB_ACCESS_TOKEN=

# Google PageSpeed (optional — /ferramentas/auditoria-site speed check works without it, rate-limited)
GOOGLE_PAGESPEED_API_KEY=

# /painel (dashboard + blog admin) — closed until a login is set (HTTP Basic auth).
# One login per admin, name:password pairs separated by commas:
PAINEL_USERS=
# …or a single shared login:
# PAINEL_USER=lk
# PAINEL_PASSWORD=
